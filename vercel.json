{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,**/test_*.py,**/*.test.py,fixtures/**,testdata/**,sample-data/**,venv/**,.venv/**,.git/**,*.md,Makefile,README.md,README.th.md}"
    }
  }
}